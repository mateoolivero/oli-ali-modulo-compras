<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_oliali" targetNamespace="https://github.com/oli-ali/modulo-compras" exporter="Elaboración propia" exporterVersion="1.0">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="P_df" name="Dragonfish (sistema de gestión)" />
    <bpmn:participant id="P_oa" name="Olí Ali" processRef="Proc_reposicion" />
    <bpmn:participant id="P_pr" name="Proveedor" />
    <bpmn:messageFlow id="m1" name="Exportación de ventas y stock" sourceRef="P_df" targetRef="T1" />
    <bpmn:messageFlow id="m2" name="Ajuste de stock" sourceRef="T6" targetRef="P_df" />
    <bpmn:messageFlow id="m3" name="Orden de compra" sourceRef="T10" targetRef="P_pr" />
    <bpmn:messageFlow id="m4" name="Mercadería y remito" sourceRef="P_pr" targetRef="C1" />
    <bpmn:messageFlow id="m5" name="Reclamo" sourceRef="T12" targetRef="P_pr" />
    <bpmn:messageFlow id="m6" name="Alta de mercadería" sourceRef="T13" targetRef="P_df" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_reposicion" name="Reposición de mercadería basada en datos" isExecutable="false">
    <bpmn:laneSet id="LS">
      <bpmn:lane id="L_mod" name="Módulo de análisis (sistema)">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_enc" name="Encargada de sucursal">
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_dir" name="Dirección / Compras (dueño)">
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_dep" name="Depósito y Recepción">
        <bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Todos los días 7:00">
      <bpmn:outgoing>f1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="S1_td"><bpmn:timeCycle>R/T07:00/P1D</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="T1" name="Importar ventas y stock de Dragonfish">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="¿Importación correcta?">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T2" name="Registrar error y avisar a Sistemas">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E1" name="Importación fallida">
      <bpmn:incoming>f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T3" name="Calcular rotación, quiebres y estacionalidad">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G2" name="¿Hay artículos bajo stock mínimo?">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E2" name="Sin reposición">
      <bpmn:incoming>f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T4" name="Generar alerta y sugerencia de reposición">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T5" name="Verificar stock físico en el local">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G3" name="¿Coincide con el sistema?">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T6" name="Ajustar stock en Dragonfish">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G4" name="">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T8" name="Revisar sugerencia y reportes">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G5" name="¿Aprueba sin cambios?">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T9" name="Ajustar cantidades o proveedor">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G6" name="">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T10" name="Enviar orden de compra">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="C1" name="Mercadería recibida">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C1_md" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T11" name="Controlar mercadería contra la orden">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G7" name="¿Coincide con lo pedido?">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T12" name="Registrar diferencia y reclamar al proveedor">
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="G8" name="">
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T13" name="Cargar ingreso en Dragonfish">
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:outgoing>f27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E3" name="Mercadería disponible para la venta">
      <bpmn:incoming>f27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" name="" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="f2" name="" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="f3" name="Sí" sourceRef="G1" targetRef="T3" />
    <bpmn:sequenceFlow id="f4" name="No" sourceRef="G1" targetRef="T2" />
    <bpmn:sequenceFlow id="f5" name="" sourceRef="T2" targetRef="E1" />
    <bpmn:sequenceFlow id="f6" name="" sourceRef="T3" targetRef="G2" />
