    <bpmn:sequenceFlow id="f19" name="" sourceRef="G6" targetRef="T10" />
    <bpmn:sequenceFlow id="f20" name="" sourceRef="T10" targetRef="C1" />
    <bpmn:sequenceFlow id="f21" name="" sourceRef="C1" targetRef="T11" />
    <bpmn:sequenceFlow id="f22" name="" sourceRef="T11" targetRef="G7" />
    <bpmn:sequenceFlow id="f23" name="Sí" sourceRef="G7" targetRef="G8" />
    <bpmn:sequenceFlow id="f24" name="No" sourceRef="G7" targetRef="T12" />
    <bpmn:sequenceFlow id="f25" name="" sourceRef="T12" targetRef="G8" />
    <bpmn:sequenceFlow id="f26" name="" sourceRef="G8" targetRef="T13" />
    <bpmn:sequenceFlow id="f27" name="" sourceRef="T13" targetRef="E3" />
  </bpmn:process>
